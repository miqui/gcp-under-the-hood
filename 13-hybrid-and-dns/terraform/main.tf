locals {
  vm_zone     = "${var.region}-a"
  gcp_domain  = "gcp.example.internal."
  corp_domain = "corp.example.internal."
  split_name  = "split.example.internal."

  cloud_ip  = [cidrhost("169.254.10.0/30", 1), cidrhost("169.254.11.0/30", 1)]
  onprem_ip = [cidrhost("169.254.10.0/30", 2), cidrhost("169.254.11.0/30", 2)]
  meds      = [var.tunnel1_med, var.tunnel2_med]
}

resource "google_project_service" "apis" {
  for_each           = toset(["compute.googleapis.com", "dns.googleapis.com"])
  service            = each.key
  disable_on_destroy = false
}

# ---------------------------------------------------------------- VPCs
resource "google_compute_network" "cloud" {
  name                    = "hyb-cloud"
  auto_create_subnetworks = false
  routing_mode            = var.cloud_routing_mode
  depends_on              = [google_project_service.apis]
}

resource "google_compute_network" "onprem" {
  name                    = "hyb-onprem" # simulated on-prem
  auto_create_subnetworks = false
  routing_mode            = "GLOBAL"
  depends_on              = [google_project_service.apis]
}

resource "google_compute_network" "spoke" {
  name                    = "hyb-spoke"
  auto_create_subnetworks = false
  depends_on              = [google_project_service.apis]
}

resource "google_compute_subnetwork" "cloud" {
  name          = "hyb-cloud-sn"
  network       = google_compute_network.cloud.id
  region        = var.region
  ip_cidr_range = var.cloud_cidr
}

resource "google_compute_subnetwork" "onprem" {
  name          = "hyb-onprem-sn"
  network       = google_compute_network.onprem.id
  region        = var.region
  ip_cidr_range = var.onprem_cidr
}

resource "google_compute_subnetwork" "spoke" {
  name          = "hyb-spoke-sn"
  network       = google_compute_network.spoke.id
  region        = var.region
  ip_cidr_range = var.spoke_cidr
}

# ---------------------------------------------------------------- Firewall
resource "google_compute_firewall" "cloud_in" {
  name    = "hyb-cloud-allow"
  network = google_compute_network.cloud.name
  allow {
    protocol = "icmp"
  }
  allow {
    protocol = "tcp"
    ports    = ["22", "53", "8080"]
  }
  allow {
    protocol = "udp"
    ports    = ["53"]
  }
  # IAP range + onprem + spoke + self
  source_ranges = ["35.235.240.0/20", var.onprem_cidr, var.spoke_cidr, var.cloud_cidr]
}

resource "google_compute_firewall" "onprem_in" {
  name    = "hyb-onprem-allow"
  network = google_compute_network.onprem.name
  allow {
    protocol = "icmp"
  }
  allow {
    protocol = "tcp"
    ports    = ["22", "53", "8080"]
  }
  allow {
    protocol = "udp"
    ports    = ["53"]
  }
  source_ranges = ["35.235.240.0/20", var.onprem_cidr, var.cloud_cidr]
}

# Cloud DNS forwarded queries originate from 35.199.192.0/19.
resource "google_compute_firewall" "onprem_dns_forwarders" {
  name          = "hyb-onprem-allow-dns-fwd"
  network       = google_compute_network.onprem.name
  source_ranges = ["35.199.192.0/19"]
  allow {
    protocol = "udp"
    ports    = ["53"]
  }
  allow {
    protocol = "tcp"
    ports    = ["53"]
  }
}

# ---------------------------------------------------------------- HA VPN + BGP
resource "google_compute_ha_vpn_gateway" "cloud" {
  name    = "hyb-cloud-gw"
  network = google_compute_network.cloud.id
  region  = var.region
}

resource "google_compute_ha_vpn_gateway" "onprem" {
  name    = "hyb-onprem-gw"
  network = google_compute_network.onprem.id
  region  = var.region
}

resource "google_compute_router" "cloud" {
  name    = "hyb-cloud-rtr"
  network = google_compute_network.cloud.id
  region  = var.region
  bgp {
    asn               = 64514
    advertise_mode    = "CUSTOM"
    advertised_groups = ["ALL_SUBNETS"]
    advertised_ip_ranges {
      range       = "10.99.0.0/24"
      description = "Custom advertised range (no subnet needed)"
    }
  }
}

resource "google_compute_router" "onprem" {
  name    = "hyb-onprem-rtr"
  network = google_compute_network.onprem.id
  region  = var.region
  bgp {
    asn            = 64515
    advertise_mode = "DEFAULT" # advertises onprem subnets
  }
}

# Shared secrets generated by Terraform; never output.
resource "random_password" "vpn" {
  count   = 2
  length  = 32
  special = false
}

resource "google_compute_vpn_tunnel" "cloud_to_onprem" {
  count                 = 2
  name                  = "hyb-c2o-${count.index}"
  region                = var.region
  vpn_gateway           = google_compute_ha_vpn_gateway.cloud.id
  vpn_gateway_interface = count.index
  peer_gcp_gateway      = google_compute_ha_vpn_gateway.onprem.id
  shared_secret         = random_password.vpn[count.index].result
  router                = google_compute_router.cloud.id
}

resource "google_compute_vpn_tunnel" "onprem_to_cloud" {
  count                 = 2
  name                  = "hyb-o2c-${count.index}"
  region                = var.region
  vpn_gateway           = google_compute_ha_vpn_gateway.onprem.id
  vpn_gateway_interface = count.index
  peer_gcp_gateway      = google_compute_ha_vpn_gateway.cloud.id
  shared_secret         = random_password.vpn[count.index].result
  router                = google_compute_router.onprem.id
}

resource "google_compute_router_interface" "cloud" {
  count      = 2
  name       = "if-c2o-${count.index}"
  router     = google_compute_router.cloud.name
  region     = var.region
  ip_range   = "${local.cloud_ip[count.index]}/30"
  vpn_tunnel = google_compute_vpn_tunnel.cloud_to_onprem[count.index].name
}

resource "google_compute_router_peer" "cloud" {
  count                     = 2
  name                      = "peer-c2o-${count.index}"
  router                    = google_compute_router.cloud.name
  region                    = var.region
  peer_ip_address           = local.onprem_ip[count.index]
  peer_asn                  = 64515
  advertised_route_priority = local.meds[count.index]
  interface                 = google_compute_router_interface.cloud[count.index].name
}

resource "google_compute_router_interface" "onprem" {
  count      = 2
  name       = "if-o2c-${count.index}"
  router     = google_compute_router.onprem.name
  region     = var.region
  ip_range   = "${local.onprem_ip[count.index]}/30"
  vpn_tunnel = google_compute_vpn_tunnel.onprem_to_cloud[count.index].name
}

resource "google_compute_router_peer" "onprem" {
  count                     = 2
  name                      = "peer-o2c-${count.index}"
  router                    = google_compute_router.onprem.name
  region                    = var.region
  peer_ip_address           = local.cloud_ip[count.index]
  peer_asn                  = 64514
  advertised_route_priority = local.meds[count.index]
  interface                 = google_compute_router_interface.onprem[count.index].name
}

# ---------------------------------------------------------------- DNS
resource "google_dns_managed_zone" "gcp" {
  name       = "hyb-gcp-private"
  dns_name   = local.gcp_domain
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.cloud.id
    }
  }
  depends_on = [google_project_service.apis]
}

resource "google_dns_record_set" "gcp_app" {
  managed_zone = google_dns_managed_zone.gcp.name
  name         = "app.${local.gcp_domain}"
  type         = "A"
  ttl          = 60
  rrdatas      = [cidrhost(var.cloud_cidr, 10)]
}

# "On-prem" authoritative zone (simulated by a private zone on the onprem VPC)
resource "google_dns_managed_zone" "corp" {
  name       = "hyb-corp-private"
  dns_name   = local.corp_domain
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.onprem.id
    }
  }
  depends_on = [google_project_service.apis]
}

resource "google_dns_record_set" "corp_db" {
  managed_zone = google_dns_managed_zone.corp.name
  name         = "db.${local.corp_domain}"
  type         = "A"
  ttl          = 60
  rrdatas      = [cidrhost(var.onprem_cidr, 10)]
}

# Split horizon: same name, different answer per VPC
resource "google_dns_managed_zone" "split_cloud" {
  name       = "hyb-split-cloud"
  dns_name   = local.split_name
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.cloud.id
    }
  }
  depends_on = [google_project_service.apis]
}

resource "google_dns_managed_zone" "split_onprem" {
  name       = "hyb-split-onprem"
  dns_name   = local.split_name
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.onprem.id
    }
  }
  depends_on = [google_project_service.apis]
}

resource "google_dns_record_set" "split_cloud" {
  managed_zone = google_dns_managed_zone.split_cloud.name
  name         = "www.${local.split_name}"
  type         = "A"
  ttl          = 60
  rrdatas      = [cidrhost(var.cloud_cidr, 10)]
}

resource "google_dns_record_set" "split_onprem" {
  managed_zone = google_dns_managed_zone.split_onprem.name
  name         = "www.${local.split_name}"
  type         = "A"
  ttl          = 60
  rrdatas      = [cidrhost(var.onprem_cidr, 10)]
}

# Reserved resolver IPs: inbound-forwarding entry points (one per VPC)
resource "google_compute_address" "cloud_inbound" {
  name         = "hyb-cloud-dns-in"
  region       = var.region
  subnetwork   = google_compute_subnetwork.cloud.id
  address_type = "INTERNAL"
  purpose      = "DNS_RESOLVER"
  address      = cidrhost(var.cloud_cidr, 5)
}

resource "google_compute_address" "onprem_inbound" {
  name         = "hyb-onprem-dns-in"
  region       = var.region
  subnetwork   = google_compute_subnetwork.onprem.id
  address_type = "INTERNAL"
  purpose      = "DNS_RESOLVER"
  address      = cidrhost(var.onprem_cidr, 5)
}

# Inbound server policies: let the other side query into each VPC.
resource "google_dns_policy" "cloud" {
  name                      = "hyb-cloud-policy"
  enable_inbound_forwarding = true
  networks {
    network_url = google_compute_network.cloud.id
  }
  depends_on = [google_compute_address.cloud_inbound]
}

resource "google_dns_policy" "onprem" {
  name                      = "hyb-onprem-policy"
  enable_inbound_forwarding = true
  networks {
    network_url = google_compute_network.onprem.id
  }
  depends_on = [google_compute_address.onprem_inbound]
}

# Outbound forwarding: cloud VPC -> corp.example.internal over the VPN.
# (An outbound *server policy* with alternative_name_server_config would instead
# send ALL queries out and bypass private zones; see README break-it #6.)
resource "google_dns_managed_zone" "fwd_corp" {
  name       = "hyb-fwd-corp"
  dns_name   = local.corp_domain
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.cloud.id
    }
  }
  forwarding_config {
    target_name_servers {
      ipv4_address    = google_compute_address.onprem_inbound.address
      forwarding_path = "private"
    }
  }
}

# Onprem forwards gcp.example.internal to the cloud inbound address
resource "google_dns_managed_zone" "onprem_fwd_gcp" {
  name       = "hyb-onprem-fwd-gcp"
  dns_name   = local.gcp_domain
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.onprem.id
    }
  }
  forwarding_config {
    target_name_servers {
      ipv4_address    = google_compute_address.cloud_inbound.address
      forwarding_path = "private"
    }
  }
}

# DNS peering: spoke VPC resolves gcp.example.internal using the cloud VPC's view
resource "google_dns_managed_zone" "spoke_peer" {
  name       = "hyb-spoke-peer-gcp"
  dns_name   = local.gcp_domain
  visibility = "private"
  private_visibility_config {
    networks {
      network_url = google_compute_network.spoke.id
    }
  }
  peering_config {
    target_network {
      network_url = google_compute_network.cloud.id
    }
  }
}

# ---------------------------------------------------------------- VMs
resource "google_compute_instance" "cloud" {
  count        = var.enable_vms ? 1 : 0
  name         = "hyb-cloud-vm"
  zone         = local.vm_zone
  machine_type = "e2-micro"
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.cloud.id
    network_ip = cidrhost(var.cloud_cidr, 10)
  }
}

resource "google_compute_instance" "onprem" {
  count        = var.enable_vms ? 1 : 0
  name         = "hyb-onprem-vm"
  zone         = local.vm_zone
  machine_type = "e2-micro"
  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-12"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.onprem.id
    network_ip = cidrhost(var.onprem_cidr, 10)
  }
}
